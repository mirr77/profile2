<!-- Falling Leaves Particle Script -->
<script>
  (function () {
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }
    var container = document.getElementById('leaves-falling-container');
    if (!container) return;

    var leafImgSrc = 'https://lh3.googleusercontent.com/aida/ALJJyrCD09IzL0iolWn5EbzWPBLWNeMa4OCpN4p5OMymY4De4yGVMfa6MbxNTxQheuQcMJJ5OJA1SYdGsJQd9dK8cUCsdcMq9YgVSajYPPvjTnSHzv-M5Jv_GLMBg3dQlxZ-7YeqhgaE5p87s5h15lJWD-aQJsOVZnOMNWDllhUIG77UxrxiIlDhH-DhlxVIHGB-oekuBBoMte7Z2sW29OSTTv4E0nj9C11lnBrBZI5EULUI';
    var swayAnimations = ['leaf-sway-1', 'leaf-sway-2', 'leaf-sway-3'];
    var totalLeaves = 16;

    for (var i = 0; i < totalLeaves; i++) {
      var img = document.createElement('img');
      img.className = 'leaf-particle-img';
      img.src = leafImgSrc;
      img.alt = '';
      img.setAttribute('aria-hidden', 'true');

      var randomX = Math.floor(Math.random() * 92) + 4;
      var randomSize = Math.floor(28 + Math.random() * 20); 
      var randomFallDuration = (18.0 + Math.random() * 11.0).toFixed(1);
      var randomSwayDuration = (6.0 + Math.random() * 4.0).toFixed(1);
      var staggeredDelay = (i * 1.5 + Math.random() * 1.2).toFixed(1);
      var randomOpacity = (0.55 + Math.random() * 0.25).toFixed(2);
      var isFlipped = (i % 2 === 0);
      var initialRotate = Math.floor(Math.random() * 40) - 20;
      var swayType = swayAnimations[i % swayAnimations.length];

      img.style.left = randomX + '%';
      img.style.width = randomSize + 'px';
      img.style.height = 'auto';
      img.style.setProperty('--leaf-target-opacity', randomOpacity);
      img.style.setProperty('--sway-animation', swayType);
      img.style.animationDuration = randomFallDuration + 's, ' + randomSwayDuration + 's';
      img.style.animationDelay = staggeredDelay + 's, ' + (staggeredDelay * 0.35).toFixed(1) + 's';
      img.style.transform = (isFlipped ? 'scaleX(-1) ' : 'scaleX(1) ') + 'rotate(' + initialRotate + 'deg)';

      container.appendChild(img);
    }
  })();
</script>




















