<h1 class="font-dasan font-bold sm:text-[50px] lg:text-[62px] leading-tight text-[#1C2822] tracking-tight flex items-baseline gap-1 sm:gap-2 flex-wrap text-[55px]" style="font-size: clamp(50px, 6.4vw, 84px); line-height: 1.1; letter-spacing: -0.035em;"><span class="inline-flex items-baseline flex-nowrap">
