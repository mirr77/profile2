<!-- Interactive Script for Vertical Drawing Line Movement & Node Triggering -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const timelineContainer = document.getElementById('timeline-container');
    const activeLine = document.getElementById('svg-active-line');
    const projectItems = document.querySelectorAll('.project-card-item');

    // 1. Intersection Observer for progressive Card Fade-In & Node Activation
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -15% 0px',
      threshold: 0.15
    };

    const cardObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          const node = entry.target.querySelector('.timeline-node');
          if (node) {
            node.classList.add('is-active');
          }
        }
      });
    }, observerOptions);

    projectItems.forEach(item => cardObserver.observe(item));

    // 2. Dynamic Scroll & Intersection Line-Drawing Logic
    function updateTimelineDraw() {
      if (!timelineContainer || !activeLine) return;

      const rect = timelineContainer.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const totalHeight = rect.height;

      // Calculate how far into the timeline container the viewport has scrolled
      const startTrigger = windowHeight * 0.75;
      const progressPixels = startTrigger - rect.top;
      
      let progress = progressPixels / totalHeight;
      progress = Math.max(0, Math.min(1, progress));

      // Calculate SVG stroke Dash Offset for smooth drawn appearance
      const svgHeight = totalHeight - 76; // offset top node to bottom
      const drawLength = Math.max(0, svgHeight);

      activeLine.style.strokeDasharray = `${drawLength}`;
      const offset = drawLength * (1 - progress);
      activeLine.style.strokeDashoffset = `${offset}`;
    }

    window.addEventListener('scroll', updateTimelineDraw, { passive: true });
    window.addEventListener('resize', updateTimelineDraw);
    // Initial run
    setTimeout(updateTimelineDraw, 100);
  });
</script>




























